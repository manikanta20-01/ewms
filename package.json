{
  "name": "ewms",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^8",
    "@sap/xssec": "^4",
    "express": "^4",
    "hdb": "^0.19.9"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^9.9.4"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "cds": {
    "requires": {
      "outbox": false,
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "kind": "mocked",
        "restrict_all_services": true,
        "users": {
          "empjohn": {
            "roles": [
              "Employee"
            ],
            "attr": {
              "employeeId": "10000000-0000-0000-0000-000000000001",
              "departmentId": "11111111-dddd-1111-dddd-111111111111"
            }
          },
          "mgrdept": {
            "roles": [
              "DepartmentManager"
            ],
            "attr": {
              "employeeId": "10000000-0000-0000-0000-000000000004",
              "departmentId": "11111111-dddd-1111-dddd-111111111111"
            }
          },
          "hrperson": {
            "roles": [
              "HRAdmin"
            ],
            "attr": {
              "employeeId": "10000000-0000-0000-0000-000000000002",
              "departmentId": "11111111-dddd-1111-dddd-111111111111"
            }
          },
          "payexec": {
            "roles": [
              "PayrollExecutive"
            ],
            "attr": {
              "employeeId": "10000000-0000-0000-0000-000000000006",
              "departmentId": "11111111-dddd-1111-dddd-111111111111"
            }
          }
        }
      }
    },
    "[production]": {
      "requires": {
        "db": {
          "kind": "hana"
        },
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  }
}
