<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"
          xmlns:core="sap.ui.core"
          controllerName="ewms.EWMS.controller.AttendanceList">
  <!-- Sprint 28 - Attendance list. Rows come from the real
       AttendanceService; role visibility is backend-decided. -->
  <Page id="attListPage" title="Attendance" showNavButton="true"
        navButtonPress=".onNavBack">
    <headerContent>
      <Toolbar>
        <Button text="Check in" icon="sap-icon://clock-in" type="Emphasized"
                press=".onOpenCheckIn"/>
        <ToolbarSpacer/>
        <Text text="{att>/pageLabel}"/>
      </Toolbar>
    </headerContent>
    <subHeader>
      <Toolbar>
        <Label text="From" class="sapUiSmallMarginEnd"/>
        <DatePicker id="attDateFrom" valueFormat="yyyy-MM-dd"
                    displayFormat="yyyy-MM-dd"
                    value="{att>/filterDateFrom}"
                    change=".onFilterChange"/>
        <Label text="To" class="sapUiSmallMarginBeginEnd"/>
        <DatePicker id="attDateTo" valueFormat="yyyy-MM-dd"
                    displayFormat="yyyy-MM-dd"
                    value="{att>/filterDateTo}"
                    change=".onFilterChange"/>
        <Select id="attStatusSel" width="10rem" forceSelection="false"
                selectedKey="{att>/filterStatus}"
                change=".onFilterChange"
                items="{att>/statusOptions}">
          <items><core:Item key="{att>key}" text="{att>text}"/></items>
        </Select>
      </Toolbar>
    </subHeader>
    <content>
      <MessageStrip visible="{att>/error}" type="Error" showIcon="true"
                    text="{att>/errorText}"/>
      <Table id="attTable"
             items="{att>/rows}"
             busyIndicatorDelay="0"
             busy="{att>/busy}"
             noDataText="No attendance records for the selected filters">
        <columns>
          <Column width="8rem"><Text text="Date"/></Column>
          <Column width="18rem"><Text text="Employee"/></Column>
          <Column width="10rem"><Text text="Status"/></Column>
          <Column width="12rem"><Text text="Work location"/></Column>
          <Column width="8rem"><Text text="In"/></Column>
          <Column width="8rem"><Text text="Out"/></Column>
          <Column width="9rem"><Text text="Late"/></Column>
        </columns>
        <items>
          <ColumnListItem type="Active" press=".onRowPress">
            <cells>
              <Text text="{att>attendanceDate}"/>
              <Text text="{att>employeeText}"/>
              <Text text="{att>statusText}"/>
              <Text text="{att>workLocation}"/>
              <Text text="{att>checkIn}"/>
              <Text text="{att>checkOut}"/>
              <Text text="{att>lateMinutes}"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>
